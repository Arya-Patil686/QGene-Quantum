# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/
web/dist/

# Raw ClinVar download — 420 MB archive plus the filtered extract.
# Regenerate with `./scripts/fetch_clinvar.sh` or `make data`.
data/raw/*.gz
data/raw/*.tsv
data/raw/*.err
data/raw/parts/

# Derived arrays — regenerate with `make data`
data/processed/

# Bundled dataset archives — the four extracted files the loaders read are
# committed; re-download with ./scripts/fetch_bundled.sh
data/bundled/*.zip
data/bundled/heart/costs/
data/bundled/parkinsons/telemonitoring/

# OS
.DS_Store
